.TH "KC" "1" "Jan 0001" "kc dev" "kc Manual"

.SH NAME
kc-config-list - Show every setting with its effective value


.SH SYNOPSIS
\fBkc config list [flags]\fP


.SH DESCRIPTION
Show every setting with its effective value


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for list

.PP
\fB--json\fP[=false]
	output structured JSON


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--vault\fP=""
	target vault (overrides active vault)


.SH SEE ALSO
\fBkc-config(1)\fP
