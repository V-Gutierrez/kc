.TH "KC" "1" "Jan 0001" "kc dev" "kc Manual"

.SH NAME
kc-config-path - Print the config file location


.SH SYNOPSIS
\fBkc config path [flags]\fP


.SH DESCRIPTION
Print the config file location


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for path


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--vault\fP=""
	target vault (overrides active vault)


.SH SEE ALSO
\fBkc-config(1)\fP
