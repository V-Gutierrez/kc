.TH "KC" "1" "Jan 0001" "kc dev" "kc Manual"

.SH NAME
kc-list - List all keys in a vault


.SH SYNOPSIS
\fBkc list [flags]\fP


.SH DESCRIPTION
Lists all key names stored in the active vault (or --vault). Values are not shown.


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for list

.PP
\fB--json\fP[=false]
	output structured JSON

.PP
\fB--protected\fP[=false]
	show only Touch ID protected keys and their status

.PP
\fB--show-values\fP[=false]
	include secret values in list output


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--vault\fP=""
	target vault (overrides active vault)


.SH SEE ALSO
\fBkc(1)\fP
